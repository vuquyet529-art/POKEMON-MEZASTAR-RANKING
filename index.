<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pokémon MEZASTAR - Bảng Xếp Hạng Trực Tiếp</title>
    <!-- Google Fonts & FontAwesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --bg-dark: #0a0f24;
            --bg-card: rgba(22, 33, 62, 0.75);
            --mezastar-gold: #ffd700;
            --mezastar-gold-deg: linear-gradient(135deg, #ffe600 0%, #ff9900 100%);
            --pokeball-red: #ff2a2a;
            --text-main: #ffffff;
            --text-muted: #a0aec0;
            --accent-blue: #00d2ff;
            --border-glow: rgba(255, 215, 0, 0.3);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Roboto', sans-serif;
            background: var(--bg-dark);
            background-image: 
                radial-gradient(circle at 50% 10%, rgba(255, 42, 42, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 80% 80%, rgba(0, 210, 255, 0.1) 0%, transparent 50%);
            color: var(--text-main);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* HEADER SECTION */
        header {
            text-align: center;
            padding: 20px 0 30px;
            position: relative;
        }

        .logo-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.8rem;
            font-weight: 900;
            background: var(--mezastar-gold-deg);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 0 20px rgba(255, 215, 0, 0.4);
            margin-bottom: 8px;
        }

        .subtitle {
            font-size: 1.2rem;
            color: #4deeea;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 700;
        }

        .status-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--bg-card);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border-glow);
            padding: 12px 24px;
            border-radius: 50px;
            margin: 20px 0 30px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .live-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            font-weight: bold;
            color: var(--pokeball-red);
            text-transform: uppercase;
        }

        .pulse-dot {
            width: 10px;
            height: 10px;
            background-color: var(--pokeball-red);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--pokeball-red);
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 42, 42, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(255, 42, 42, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 42, 42, 0); }
        }

        .search-box {
            position: relative;
            width: 300px;
        }

        .search-box input {
            width: 100%;
            padding: 8px 16px 8px 36px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(0, 0, 0, 0.3);
            color: #fff;
            outline: none;
            transition: all 0.3s;
        }

        .search-box input:focus {
            border-color: var(--mezastar-gold);
            box-shadow: 0 0 10px rgba(255, 215, 0, 0.3);
        }

        .search-box i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
        }

        /* PODIUM TOP 3 */
        .podium-container {
            display: flex;
            justify-content: center;
            align-items: flex-end;
            gap: 20px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .top-card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            position: relative;
            backdrop-filter: blur(10px);
            border: 2px solid transparent;
            transition: transform 0.3s ease;
            width: 280px;
        }

        .top-card:hover {
            transform: translateY(-5px);
        }

        .top-card.rank-1 {
            border-color: #ffd700;
            box-shadow: 0 0 25px rgba(255, 215, 0, 0.3);
            order: 2;
            transform: scale(1.05);
        }

        .top-card.rank-2 {
            border-color: #c0c0c0;
            box-shadow: 0 0 15px rgba(192, 192, 192, 0.2);
            order: 1;
        }

        .top-card.rank-3 {
            border-color: #cd7f32;
            box-shadow: 0 0 15px rgba(205, 127, 50, 0.2);
            order: 3;
        }

        .crown-icon {
            font-size: 2rem;
            margin-bottom: 10px;
        }

        .rank-1 .crown-icon { color: #ffd700; }
        .rank-2 .crown-icon { color: #c0c0c0; }
        .rank-3 .crown-icon { color: #cd7f32; }

        .team-names {
            font-weight: bold;
            font-size: 1.1rem;
            margin-bottom: 8px;
            color: #fff;
        }

        .trainer-ids {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 12px;
        }

        .top-score {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.8rem;
            font-weight: bold;
            color: var(--mezastar-gold);
        }

        /* LEADERBOARD TABLE */
        .table-container {
            background: var(--bg-card);
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th {
            background: rgba(0, 0, 0, 0.4);
            font-family: 'Orbitron', sans-serif;
            color: var(--mezastar-gold);
            padding: 16px;
            font-size: 0.9rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-bottom: 2px solid rgba(255, 215, 0, 0.2);
        }

        td {
            padding: 16px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 0.95rem;
        }

        tr:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .rank-badge {
            font-family: 'Orbitron', sans-serif;
            font-weight: bold;
            display: inline-block;
            width: 36px;
            height: 36px;
            line-height: 36px;
            text-align: center;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
        }

        .rank-1-badge { background: #ffd700; color: #000; box-shadow: 0 0 10px #ffd700; }
        .rank-2-badge { background: #c0c0c0; color: #000; }
        .rank-3-badge { background: #cd7f32; color: #fff; }

        .player-info {
            display: flex;
            flex-direction: column;
        }

        .player-name {
            font-weight: 600;
            color: #fff;
        }

        .trainer-id {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .time-badge {
            background: rgba(0, 210, 255, 0.1);
            color: var(--accent-blue);
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .score-val {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--mezastar-gold);
        }

        /* LOADING SPINNER */
        .loading {
            text-align: center;
            padding: 40px;
            font-size: 1.2rem;
            color: var(--mezastar-gold);
        }

        @media (max-width: 768px) {
            .podium-container { flex-direction: column; align-items: center; }
            .top-card.rank-1 { order: 1; transform: scale(1); }
            .top-card.rank-2 { order: 2; }
            .top-card.rank-3 { order: 3; }
            .status-bar { flex-direction: column; gap: 15px; border-radius: 16px; }
            .search-box { width: 100%; }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- HEADER -->
        <header>
            <h1 class="logo-title"><i class="fa-solid fa-star"></i> POKÉMON MEZASTAR <i class="fa-solid fa-star"></i></h1>
            <div class="subtitle">BẢNG XẾP HẠNG TAG BATTLE CHALLENGE</div>
        </header>

        <!-- STATUS BAR -->
        <div class="status-bar">
            <div class="live-badge">
                <div class="pulse-dot"></div>
                <span>Trực Tiếp • Cập nhật tự động</span>
            </div>
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="searchInput" placeholder="Tìm tên người chơi hoặc Trainer ID..." onkeyup="filterLeaderboard()">
            </div>
            <div id="lastUpdated" style="font-size: 0.85rem; color: var(--text-muted);">
                Đang tải dữ liệu...
            </div>
        </div>

        <!-- TOP 3 PODIUM -->
        <div class="podium-container" id="podium">
            <!-- Dynamic Top 3 rendered here -->
        </div>

        <!-- FULL LEADERBOARD TABLE -->
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th style="width: 80px; text-align: center;">HẠNG</th>
                        <th>NGƯỜI CHƠI 1</th>
                        <th>NGƯỜI CHƠI 2</th>
                        <th style="width: 140px;">KHUNG GIỜ</th>
                        <th style="width: 140px; text-align: right;">ĐIỂM SỐ</th>
                    </tr>
                </thead>
                <tbody id="leaderboardBody">
                    <tr>
                        <td colspan="5" class="loading">
                            <i class="fa-solid fa-spinner fa-spin"></i> Đang tải dữ liệu xếp hạng...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        const SHEET_ID = '1y8gL7yJTViGX33N5PO0ggpXG94uEPVdjFkBQDNh7b54';
        const GVIZ_URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json&gid=0`;

        let rawLeaderboardData = [];

        async function fetchRankingData() {
            try {
                const response = await fetch(GVIZ_URL);
                const text = await response.text();
                
                // Trích xuất JSON từ phản hồi GViz
                const jsonString = text.substring(text.indexOf('{'), text.lastIndexOf('}') + 1);
                const data = JSON.parse(jsonString);
                
                const rows = data.table.rows;
                let parsedData = [];

                rows.forEach(row => {
                    const cells = row.c;
                    if (!cells) return;

                    // Đọc giá trị từng cột tương ứng với Google Sheet
                    const p1 = cells[1] ? (cells[1].v || '') : '';
                    const id1 = cells[2] ? (cells[2].v || '') : '';
                    const p2 = cells[3] ? (cells[3].v || '') : '';
                    const id2 = cells[4] ? (cells[4].v || '') : '';
                    const time = cells[5] ? (cells[5].v || cells[5].f || '') : '';
                    const scoreRaw = cells[6] ? cells[6].v : 0;
                    const score = parseFloat(scoreRaw) || 0;

                    // Chỉ lấy hàng có tên người chơi
                    if (p1.toString().trim() !== '' || p2.toString().trim() !== '') {
                        parsedData.push({ p1, id1, p2, id2, time, score });
                    }
                });

                // TỰ ĐỘNG SẮP XẾP THEO ĐIỂM SỐ GIẢM DẦN
                parsedData.sort((a, b) => b.score - a.score);

                // Gán lại RANK tự động sau khi sắp xếp
                parsedData.forEach((item, index) => {
                    item.rank = index + 1;
                });

                rawLeaderboardData = parsedData;
                renderPodium(parsedData.slice(0, 3));
                renderLeaderboard(parsedData);
                
                const now = new Date();
                document.getElementById('lastUpdated').innerText = `Cập nhật lúc: ${now.toLocaleTimeString('vi-VN')}`;

            } catch (error) {
                console.error("Lỗi khi tải dữ liệu từ Google Sheet:", error);
            }
        }

        // VẼ KHU VỰC TOP 3 (PODIUM)
        function renderPodium(top3) {
            const podiumEl = document.getElementById('podium');
            if (!top3 || top3.length === 0) {
                podiumEl.innerHTML = '';
                return;
            }

            let html = '';
            const crowns = ['fa-crown', 'fa-medal', 'fa-award'];
            const classes = ['rank-1', 'rank-2', 'rank-3'];

            // Đổi thứ tự hiển thị podium: Top 2 -> Top 1 -> Top 3
            const displayOrder = [1, 0, 2];

            displayOrder.forEach(idx => {
                if (top3[idx]) {
                    const item = top3[idx];
                    html += `
                        <div class="top-card ${classes[idx]}">
                            <i class="fa-solid ${crowns[idx]} crown-icon"></i>
                            <div style="font-family: Orbitron; font-weight: bold; font-size: 0.9rem; color: var(--mezastar-gold); margin-bottom: 5px;">TOP ${item.rank}</div>
                            <div class="team-names">${item.p1 || '-'} & ${item.p2 || '-'}</div>
                            <div class="trainer-ids">ID: ${item.id1 || '-'} | ${item.id2 || '-'}</div>
                            <div class="top-score">${item.score.toLocaleString('vi-VN')}</div>
                        </div>
                    `;
                }
            });

            podiumEl.innerHTML = html;
        }

        // VẼ BẢNG XẾP HẠNG ĐẦY ĐỦ
        function renderLeaderboard(data) {
            const tbody = document.getElementById('leaderboardBody');
            if (data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding: 20px;">Không tìm thấy dữ liệu xếp hạng.</td></tr>';
                return;
            }

            let html = '';
            data.forEach(item => {
                let badgeClass = 'rank-badge';
                if (item.rank === 1) badgeClass += ' rank-1-badge';
                else if (item.rank === 2) badgeClass += ' rank-2-badge';
                else if (item.rank === 3) badgeClass += ' rank-3-badge';

                html += `
                    <tr>
                        <td style="text-align: center;"><span class="${badgeClass}">${item.rank}</span></td>
                        <td>
                            <div class="player-info">
                                <span class="player-name">${item.p1 || '-'}</span>
                                <span class="trainer-id">${item.id1 ? 'ID: ' + item.id1 : ''}</span>
                            </div>
                        </td>
                        <td>
                            <div class="player-info">
                                <span class="player-name">${item.p2 || '-'}</span>
                                <span class="trainer-id">${item.id2 ? 'ID: ' + item.id2 : ''}</span>
                            </div>
                        </td>
                        <td><span class="time-badge"><i class="fa-regular fa-clock"></i> ${item.time || '-'}</span></td>
                        <td style="text-align: right;"><span class="score-val">${item.score.toLocaleString('vi-VN')}</span></td>
                    </tr>
                `;
            });

            tbody.innerHTML = html;
        }

        // TÌM KIẾM THEO TÊN NGUYỄN CHƠI HOẶC TRAINER ID
        function filterLeaderboard() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            if (!query) {
                renderLeaderboard(rawLeaderboardData);
                return;
            }

            const filtered = rawLeaderboardData.filter(item => 
                item.p1.toLowerCase().includes(query) ||
                item.p2.toLowerCase().includes(query) ||
                item.id1.toString().toLowerCase().includes(query) ||
                item.id2.toString().toLowerCase().includes(query)
            );

            renderLeaderboard(filtered);
        }

        // TỰ ĐỘNG CẬP NHẬT MỖI 10 GIÂY
        fetchRankingData();
        setInterval(fetchRankingData, 10000);
    </script>
</body>
</html>
